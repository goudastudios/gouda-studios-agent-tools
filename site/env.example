# Copy these into the Vercel project env (Production + Preview).
# Never commit real values.

# Required for the paid path to run the Apify actor after a valid payment.
APIFY_TOKEN=

# Required to switch this endpoint from Base Sepolia (x402.org testnet
# facilitator) to Base mainnet via the Coinbase CDP facilitator, and to
# appear in the CDP Bazaar after one successful mainnet payment.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Optional overrides. Defaults are already correct for this product.
# X402_PAY_TO=0x19dD41Db74AB8E5dc52E46d0d8bf470E27cFf886
# X402_PRICE=$0.03
# X402_NETWORK=eip155:8453

# RapidAPI gateway proxy secret. Set this to the value RapidAPI Studio shows
# under the API's Proxy Secret, then point RapidAPI at /api/rapidapi/*.
# Requests without a matching X-RapidAPI-Proxy-Secret header are rejected (401).
# Single secret, or a comma-separated list if each RapidAPI listing has its own.
# RAPIDAPI_PROXY_SECRET=
