    "/acts/gouda_studios~gleif-company-lei-lookup/run-sync-get-dataset-items": {
      "post": {
        "operationId": "run_gleif_company_lei_lookup",
        "summary": "Run GLEIF Company LEI Lookup and return dataset items",
        "description": "Find any company LEI number by name, or look up an LEI, in the official GLEIF global registry. Get the legal name, status, jurisdiction, registration number, legal and HQ address, and direct and ultimate parent companies. For KYC, KYB, vendor checks and data enrichment. Pricing: $0.001 per run + $0.003 per company.",
        "externalDocs": {
          "url": "https://apify.com/gouda_studios/gleif-company-lei-lookup"
        },
        "parameters": [
          {
            "name": "timeout",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Run timeout in seconds"
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "json"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "companyNames": {
                    "type": "array",
                    "description": "Legal names to look up, e.g. [\"Apple Inc.\",\"Siemens AG\"]. Exact legal name match first, then fuzzy full-text.",
                    "default": []
                  },
                  "leis": {
                    "type": "array",
                    "description": "Optional 20-character LEIs to fetch directly.",
                    "default": []
                  },
                  "registrationNumbers": {
                    "type": "array",
                    "description": "Optional company-registry numbers as reported to GLEIF (registeredAs), e.g. a UK Companies House number.",
                    "default": []
                  },
                  "country": {
                    "type": "string",
                    "description": "Optional ISO 2-letter country of the legal address, e.g. US, GB, DE. Improves name matching."
                  },
                  "activeOnly": {
                    "type": "boolean",
                    "description": "true (default) = skip lapsed/inactive entities for name and registration searches.",
                    "default": true
                  },
                  "maxMatchesPerName": {
                    "type": "integer",
                    "description": "How many candidate entities to return per name or registration number (1-50).",
                    "default": 3
                  },
                  "includeParents": {
                    "type": "boolean",
                    "description": "true (default) = add direct and ultimate parent (LEI, name, country) where reported.",
                    "default": true
                  },
                  "maxResults": {
                    "type": "integer",
                    "description": "Maximum rows overall (1-5000). You pay per row: 100 rows = $0.30.",
                    "default": 100
                  }
                }
              },
              "example": {
                "companyNames": [
