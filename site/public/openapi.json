  "paths": {
    "/acts/gouda_studios~sam-gov-opportunities-feed/run-sync-get-dataset-items": {
      "post": {
        "operationId": "run_sam_gov_opportunities_feed",
        "summary": "Run SAM.gov Contract Opportunities and return dataset items",
        "description": "Get new federal contract opportunities from SAM.gov as clean JSON, no API key needed. Filter by keyword, NAICS, set-aside, notice type, agency and state. Includes deadlines, days left and contracting officer contacts. Monitor mode returns only new notices. Pricing: $0.001 per run + $0.002 per opportunity.",
        "externalDocs": {
          "url": "https://apify.com/gouda_studios/sam-gov-opportunities-feed"
        },
        "parameters": [
          {
            "name": "timeout",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Run timeout in seconds"
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "json"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "keywords": {
                    "type": "string",
                    "description": "Optional free-text search over SAM.gov notice titles and text, e.g. \"cybersecurity\" or \"janitorial services\". Leave empty to return all notices that match the other filters."
                  },
                  "naicsCodes": {
                    "type": "array",
                    "description": "Optional list of 6-digit NAICS industry codes (strings), e.g. [\"541511\",\"541512\"]. A notice matches if it has any of them. Empty = all industries.",
                    "default": []
                  },
                  "noticeTypes": {
                    "type": "array",
                    "description": "Optional list of notice type codes: o=Solicitation, k=Combined Synopsis/Solicitation, p=Presolicitation, r=Sources Sought, s=Special Notice, a=Award Notice, u=Justification, i=Intent to Bundle, g=Surplus sale. Empty = all types.",
                    "default": []
                  },
                  "setAsides": {
                    "type": "array",
                    "description": "Optional small-business set-aside codes, e.g. [\"SBA\",\"8A\",\"SDVOSBC\",\"WOSB\",\"HZC\"]. Empty = any set-aside or none.",
                    "default": []
                  },
                  "states": {
                    "type": "array",
                    "description": "Optional 2-letter US state codes for the place of performance, e.g. [\"VA\",\"MD\"]. Requires includeDetails=true. Empty = all locations.",
                    "default": []
                  },
                  "agencyContains": {
                    "type": "string",
                    "description": "Optional case-insensitive text the agency path must contain, e.g. \"Navy\" or \"Veterans Affairs\"."
                  },
                  "postedWithinDays": {
                    "type": "integer",
                    "description": "Only notices posted or updated in the last N days. 0 = no date limit. Use 1-7 for daily/weekly monitoring.",
                    "default": 0
                  },
                  "minDaysUntilResponse": {
                    "type": "integer",
                    "description": "Optional. Skip notices whose response deadline is fewer than N days away, so you only get ones you can still bid on."
                  },
                  "activeOnly": {
                    "type": "boolean",
                    "description": "true (default) = skip archived/inactive notices.",
                    "default": true
                  },
                  "includeDetails": {
                    "type": "boolean",
                    "description": "true (default) = fetch each notice for NAICS, PSC, set-aside, place of performance, full description and contacts. false = faster, fewer fields.",
                    "default": true
                  },
                  "includeContacts": {
                    "type": "boolean",
                    "description": "true (default) = include the contracting officer work name, email and phone published on the notice.",
                    "default": true
                  },
                  "onlyNew": {
                    "type": "boolean",
                    "description": "true = return only notices not delivered in an earlier run with the same filters (state is kept between runs). Use with a schedule for an alert feed.",
                    "default": false
                  },
                  "maxResults": {
                    "type": "integer",
                    "description": "Maximum rows to return (1-10000). You are charged per row returned, so this caps the cost: 100 rows = $0.20 at $0.002/row.",
                    "default": 100
                  },
                  "apiKey": {
                    "type": "string",
                    "description": "Optional. Your own free api.sam.gov public API key; when set, the Actor reads the official SAM.gov Opportunities API instead of the public search feed."
                  }
                }
              },
              "example": {
                "keywords": "cybersecurity",
                "naicsCodes": [
                  "541512"
                ],
                "setAsides": [
                  "SBA"
                ],
                "postedWithinDays": 7,
                "maxResults": 25
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dataset items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "noticeId": {
                        "description": ""
                      },
                      "title": {
                        "description": ""
                      },
                      "solicitationNumber": {
                        "description": ""
                      },
                      "noticeType": {
                        "description": ""
                      },
                      "noticeTypeCode": {
                        "description": ""
                      },
                      "department": {
                        "description": ""
                      },
                      "subTier": {
                        "description": ""
                      },
                      "office": {
                        "description": ""
                      },
                      "agencyPath": {
                        "description": ""
                      },
                      "postedDate": {
                        "description": ""
                      },
                      "modifiedDate": {
                        "description": ""
                      },
                      "responseDeadline": {
                        "description": ""
                      },
                      "daysUntilResponse": {
                        "description": ""
                      },
                      "naicsCodes": {
                        "description": ""
                      },
                      "pscCode": {
                        "description": ""
                      },
                      "setAside": {
                        "description": ""
                      },
                      "placeOfPerformanceCity": {
                        "description": ""
                      },
                      "placeOfPerformanceState": {
                        "description": ""
                      },
                      "placeOfPerformanceCountry": {
                        "description": ""
                      },
                      "awardee": {
                        "description": ""
                      },
                      "awardAmount": {
                        "description": ""
                      },
                      "awardDate": {
                        "description": ""
                      },
                      "isActive": {
                        "description": ""
                      },
                      "isCanceled": {
                        "description": ""
                      },
                      "description": {
                        "description": ""
                      },
                      "contacts": {
                        "description": ""
                      },
                      "url": {
                        "description": ""
                      },
                      "detailFetched": {
                        "description": ""
                      },
                      "source": {
                        "description": ""
                      },
                      "scrapedAt": {
                        "description": ""
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/acts/gouda_studios~sec-edgar-filings-feed/run-sync-get-dataset-items": {
      "post": {
        "operationId": "run_sec_edgar_filings_feed",
        "summary": "Run SEC EDGAR Filings and return dataset items",
        "description": "Monitor SEC EDGAR filings by ticker or CIK, including 8-K, 10-Q, 10-K, Form 4 insider trades, Form D and S-1. Each result has the company, form type, filing date and document links. Only-new mode turns it into an alert feed for investors, research and AI agents. Pricing: $0.001 per run + $0.002 per filing.",
        "externalDocs": {
          "url": "https://apify.com/gouda_studios/sec-edgar-filings-feed"
        },
        "parameters": [
          {
            "name": "timeout",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Run timeout in seconds"
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "json"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tickers": {
                    "type": "array",
                    "description": "Optional stock tickers, e.g. [\"AAPL\",\"NVDA\"]. Resolved to CIKs with the SEC ticker file.",
                    "default": []
                  },
                  "ciks": {
                    "type": "array",
                    "description": "Optional SEC Central Index Keys, e.g. [\"320193\"]. Leave tickers and CIKs empty to get latest filings across all companies.",
                    "default": []
                  },
                  "formTypes": {
                    "type": "array",
                    "description": "Form types to include, e.g. [\"8-K\",\"10-K\",\"10-Q\",\"4\",\"D\",\"S-1\",\"13F-HR\",\"SC 13D\"]. Empty = all forms (company mode only; market-wide mode needs at least one).",
                    "default": []
                  },
                  "filedWithinDays": {
                    "type": "integer",
                    "description": "Only filings from the last N days. 0 = no limit (company mode returns the ~1000 most recent).",
                    "default": 7
                  },
                  "onlyNew": {
                    "type": "boolean",
                    "description": "true = skip filings delivered by an earlier run with the same tickers/CIKs/forms. Use with a schedule for an alert feed.",
                    "default": false
                  },
                  "maxResults": {
                    "type": "integer",
                    "description": "Maximum rows (1-5000). You pay per row, so this caps cost: 100 rows = $0.20.",
                    "default": 100
                  },
                  "contactEmail": {
                    "type": "string",
                    "description": "Optional. SEC asks automated clients to identify themselves; this email is sent in the User-Agent header to sec.gov only."
                  }
                }
              },
              "example": {
                "tickers": [
                  "AAPL",
                  "TSLA"
                ],
                "formTypes": [
                  "8-K",
                  "10-Q"
                ],
                "filedWithinDays": 30,
                "maxResults": 50
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dataset items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "companyName": {
                        "description": ""
                      },
                      "cik": {
                        "description": ""
                      },
                      "filerRole": {
                        "description": ""
                      },
                      "form": {
                        "description": ""
                      },
                      "filingDate": {
                        "description": ""
                      },
                      "acceptedAt": {
                        "description": ""
                      },
                      "accessionNumber": {
                        "description": ""
                      },
                      "items": {
                        "description": ""
                      },
                      "indexUrl": {
                        "description": ""
                      },
                      "documentUrl": {
                        "description": ""
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/acts/gouda_studios~usaspending-awards-search/run-sync-get-dataset-items": {
      "post": {
        "operationId": "run_usaspending_awards_search",
        "summary": "Run USAspending Federal Awards and return dataset items",
        "description": "Search USAspending.gov federal awards by keyword, recipient, agency, NAICS, state, date and amount. Get contracts and grants with amounts, recipients, awarding agency and performance dates as JSON. Track competitors, find who won contracts and build sales prospect lists. Pricing: $0.001 per run + $0.0015 per award.",
        "externalDocs": {
          "url": "https://apify.com/gouda_studios/usaspending-awards-search"
        },
        "parameters": [
          {
            "name": "timeout",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Run timeout in seconds"
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "json"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "keywords": {
                    "type": "array",
                    "description": "Optional words to match in award descriptions, e.g. [\"cybersecurity\"].",
                    "default": []
                  },
                  "recipientNames": {
                    "type": "array",
                    "description": "Optional company or organization names (or UEIs), e.g. [\"Booz Allen Hamilton\"]. Find a competitor's federal wins.",
                    "default": []
                  },
                  "awardingAgencies": {
                    "type": "array",
                    "description": "Optional top-tier agency names exactly as USAspending lists them, e.g. [\"Department of Defense\",\"Department of Veterans Affairs\"].",
                    "default": []
                  },
                  "naicsCodes": {
                    "type": "array",
                    "description": "Optional NAICS codes (contracts only), e.g. [\"541512\"].",
                    "default": []
                  },
                  "states": {
                    "type": "array",
                    "description": "Optional 2-letter state codes, e.g. [\"VA\",\"TX\"].",
                    "default": []
                  },
                  "awardType": {
                    "type": "string",
                    "description": "contracts (default), idvs, grants, loans, direct_payments or other.",
                    "default": "contracts",
                    "enum": [
                      "contracts",
                      "idvs",
                      "grants",
                      "loans",
                      "direct_payments",
                      "other"
                    ]
                  },
                  "startDate": {
                    "type": "string",
                    "description": "YYYY-MM-DD. Defaults to 90 days ago. USAspending data starts 2007-10-01."
                  },
                  "endDate": {
                    "type": "string",
                    "description": "YYYY-MM-DD. Defaults to today."
                  },
                  "minAmount": {
                    "type": "integer",
                    "description": "Optional lower bound on award amount."
                  },
                  "maxAmount": {
                    "type": "integer",
                    "description": "Optional upper bound on award amount."
                  },
                  "onlyNew": {
                    "type": "boolean",
                    "description": "true = skip awards delivered by an earlier run with the same filters.",
                    "default": false
                  },
                  "maxResults": {
                    "type": "integer",
                    "description": "Maximum rows (1-10000). You pay per row: 100 rows = $0.15.",
                    "default": 100
                  }
                }
              },
              "example": {
                "keywords": [
                  "cybersecurity"
                ],
                "awardType": "contracts",
                "startDate": "2026-01-01",
                "maxResults": 50
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dataset items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
