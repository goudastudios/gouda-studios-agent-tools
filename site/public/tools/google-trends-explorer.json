        "null"
      ],
      "description": ""
    },
    {
      "name": "status",
      "type": [
        "string",
        "null"
      ],
      "description": ""
    }
  ],
  "description": "Bulk Google Trends data for any keyword: interest over time, interest by region, top and rising related queries, plus today's trending searches. Any country, time range, category, or YouTube/News/Shopping search. Pay only per successful keyword; blocked terms are free.",
  "page": "https://gouda-studios-agent-tools.vercel.app/tools/google-trends-explorer/",
