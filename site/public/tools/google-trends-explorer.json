{
  "slug": "google-trends-explorer",
  "name": "Google Trends Scraper",
  "title": "Google Trends Scraper: Interest, Regions, Related Queries",
  "actor": "gouda_studios/google-trends-explorer",
  "apify": "https://apify.com/gouda_studios/google-trends-explorer",
  "cat": "SEO and market research",
  "uses": [
    "SEO and content teams finding rising keywords and seasonality",
    "Product and ecommerce researchers checking demand before they build or stock",
    "Investors and analysts tracking search interest as a market signal",
    "AI agents answering whether a topic is growing, and where, with real Google Trends data"
  ],
  "inputs": [
    {
      "name": "searchTerms",
      "type": "array",
      "title": "Search terms",
      "description": "Keywords or phrases. Each one is fetched separately and returns one result row.",
      "default": null
    },
    {
      "name": "geo",
      "type": "string",
      "title": "Country or region code",
      "description": "ISO code like US, GB, DE, or US-CA. Leave empty for worldwide.",
      "default": "US"
    },
    {
      "name": "timeRange",
      "type": "string",
      "title": "Time range",
      "description": "How far back to look.",
      "default": "today 12-m",
      "enum": [
        "now 1-H",
        "now 4-H",
        "now 1-d",
        "now 7-d",
        "today 1-m",
        "today 3-m",
        "today 12-m",
        "today 5-y",
        "all"
      ]
    },
    {
      "name": "category",
      "type": "integer",
      "title": "Category ID",
      "description": "Google Trends category number, 0 for all categories.",
      "default": 0
    },
    {
      "name": "property",
      "type": "string",
      "title": "Search type",
      "description": "Which Google search the trend data comes from.",
      "default": "",
      "enum": [
        "",
        "images",
        "news",
        "froogle",
        "youtube"
      ]
    },
    {
      "name": "interestOverTime",
      "type": "boolean",
      "title": "Interest over time",
      "description": "Timeline of 0-100 interest values.",
      "default": true
    },
    {
      "name": "interestByRegion",
      "type": "boolean",
      "title": "Interest by region",
      "description": "0-100 interest for each subregion.",
      "default": true
    },
    {
      "name": "relatedQueries",
      "type": "boolean",
      "title": "Related queries",
      "description": "Top and rising related searches.",
      "default": true
    },
    {
      "name": "relatedTopics",
      "type": "boolean",
      "title": "Related topics",
      "description": "Top and rising related topics (best effort: Google often withholds these from automated sessions, so the field may be empty).",
      "default": true
    },
    {
      "name": "trendingNow",
      "type": "boolean",
      "title": "Also get today's trending searches",
      "description": "Adds one row per currently trending search in the chosen country, with traffic and news links.",
      "default": false
    },
    {
      "name": "language",
      "type": "string",
      "title": "Language",
      "description": "Interface language for names, e.g. en-US, de, es.",
      "default": "en-US"
    },
    {
      "name": "maxTerms",
      "type": "integer",
      "title": "Max search terms",
      "description": "Stop after this many terms.",
      "default": 100
    },
    {
      "name": "proxyConfiguration",
      "type": "object",
      "title": "Proxy",
      "description": "Optional. Leave off to use our built-in residential proxy, included in the price.",
      "default": null
    }
  ],
  "outputs": [
    {
      "name": "type",
      "type": "string",
      "description": ""
    },
    {
      "name": "searchTerm",
      "type": [
        "string",
